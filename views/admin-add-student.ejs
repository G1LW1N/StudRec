<%- include('partials/header', { title: "Admin Dashboard" }) %>

<div class="admin-layout">

        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <h3 class="sidebar-title">
                <img src="/images/studford-logo.png" alt="Studford Logo" class="logo-img">
                <div class="title-text">StudRec Admin</div>
            </h3>

            <ul class="sidebar-menu">
                <li><a href="/admin/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>

                <li class="has-submenu">
                    <a href="/admin/students-personal"><i class="bi bi-people"></i> Manage Students <i class="bi bi-chevron-down"></i></a>

                    <ul class="submenu">
                        <li><a href="/admin/students-personal">Personal Information</a></li>
                        <li><a href="/admin/students-academic">Academic Information</a></li>
                        <li><a href="/admin/students-accounts">Accounts</a></li>
                        <li><a href="/admin/add-student" class="active">Add New Student</a></li>
                    </ul>
                </li>

                <li><a href="/admin/courses"><i class="bi bi-journal-bookmark"></i> Manage Courses</a></li>
            </ul>

        </aside>

        <!-- Main Content -->
        <main class="admin-content">
            <!-- Top Navigation Header -->
            <header class="admin-header">

                <div class="header-right">
                    <div class="dropdown">
                        <button class="btn-profile-dropdown" type="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                            <li><a class="dropdown-item" href="/admin/logout" onclick="handleLogout(event, '/admin/logout')"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main style="flex: 1; padding: 30px; overflow-y: auto;">

            <div class="row justify-content-center">
                <div class="col-lg-8">

                    <div class="card shadow-lg border-0 form-card">
                        <div class="card-header text-white text-center py-3 rounded-top" style="background-color: #0A9C8C;">
                            <h4 class="fw-bold mb-0">Student Registration Form</h4>
                        </div>

                        <div class="card-body p-4">

                            <form method="POST" action="/admin/add-student" enctype="multipart/form-data">

                                <!-- SECTION 1: LOGIN CREDENTIALS -->
                                <div class="section-box">
                                    <h5 class="fw-bold mb-3">Login Credentials</h5>

                                    <div class="mb-3">
                                        <label>Email</label>
                                        <input name="email" type="email" required>
                                    </div>

                                    <div class="mb-3">
                                        <label>Password</label>
                                        <input name="password" type="password" required>
                                    </div>
                                </div>

                                <!-- SECTION 2: PERSONAL INFO -->
                                <div class="section-box">
                                    <h5 class="fw-bold mb-3">Personal Information</h5>

                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label>First Name</label>
                                            <input name="firstname" type="text" required>
                                        </div>

                                        <div class="col-md-4 mb-3">
                                            <label>Middle Name</label>
                                            <input name="middlename" type="text">
                                        </div>

                                        <div class="col-md-4 mb-3">
                                            <label>Last Name</label>
                                            <input name="lastname" type="text" required>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label>Birthday</label>
                                            <input name="dateofbirth" type="date" required>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label>Gender</label>
                                            <select name="gender" required>
                                                <option value="" disabled selected>Select Gender</option>
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                                <option value="Prefer not to say">Prefer not to say</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label>Phone Number</label>
                                        <input name="phonenumber" type="tel" required>
                                    </div>

                                    <div class="mb-3">
                                        <label>Address</label>
                                        <input name="address" type="text" required>
                                    </div>
                                </div>

                                <!-- SECTION 3: ACADEMIC INFO -->
                                <div class="section-box">
                                    <h5 class="fw-bold mb-3">Academic Information</h5>

                                    <div class="mb-3">
                                        <label>Course</label>
                                        <select name="course" id="courseSelect" required>
                                            <option value="" disabled selected>Select Course</option>

                                            <% courses.forEach(course => { %>
                                                <option value="<%= course.course_id %>">
                                                    <%= course.course_name %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label>Academic Year</label>
                                            <select name="academicyear" required>
                                                <option value="" disabled selected>Select Year</option>
                                                <option value="1st Year">1st Year</option>
                                                <option value="2nd Year">2nd Year</option>
                                                <option value="3rd Year">3rd Year</option>
                                                <option value="4th Year">4th Year</option>
                                            </select>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label>Section</label>
                                            <select name="section" id="sectionSelect" required>
                                                <option value="" disabled selected>Select Section</option>
                                            </select>

                                        </div>
                                    </div>

                                    <!-- COR Upload -->
                                    <div class="file-upload-container">
                                        <label>Upload Certificate of Registration</label>
                                        <input type="file" id="corfile" name="corfile" accept="image/*" required>
                                        <small class="file-note">Accepted: JPG, PNG, JPEG | Max size: 2MB</small>

                                        <div class="image-preview d-none" id="corPreviewContainer">
                                            <img id="corPreview" src="#" alt="COR Preview">
                                        </div>

                                        <div id="corError" class="text-danger fw-semibold mt-2 d-none"></div>
                                    </div>
                                </div>

                                <!-- SUBMIT -->
                                <div class="text-center mt-4">
                                    <button class="btn-teal px-5 py-2" type="submit">Register Student</button>
                                </div>

                            </form>

                        </div>
                    </div>

                </div>
            </div>
        </main>

    </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Load sections based on course selection
    const courseSelect = document.getElementById('courseSelect');
    const sectionSelect = document.getElementById('sectionSelect');

    if (courseSelect) {
        courseSelect.addEventListener('change', async (e) => {
            const courseID = e.target.value;
            
            if (!courseID) {
                sectionSelect.innerHTML = '<option value="" disabled selected>Select Section</option>';
                return;
            }

            try {
                const response = await fetch(`/student/sections/${courseID}`);
                const sections = await response.json();
                
                sectionSelect.innerHTML = '<option value="" disabled selected>Select Section</option>';
                
                sections.forEach(section => {
                    const option = document.createElement('option');
                    option.value = section;
                    option.textContent = `Section ${section}`;
                    sectionSelect.appendChild(option);
                });
            } catch (error) {
                console.error('Error loading sections:', error);
            }
        });
    }

    // File upload preview and validation
    const corfile = document.getElementById('corfile');
    const corPreview = document.getElementById('corPreview');
    const corPreviewContainer = document.getElementById('corPreviewContainer');
    const corError = document.getElementById('corError');

    if (corfile) {
        corfile.addEventListener('change', (e) => {
            const file = e.target.files[0];
            corError.classList.add('d-none');

            if (file) {
                // Check file size (max 2MB)
                if (file.size > 2 * 1024 * 1024) {
                    corError.textContent = 'File size exceeds 2MB limit.';
                    corError.classList.remove('d-none');
                    corfile.value = '';
                    corPreviewContainer.classList.add('d-none');
                    return;
                }

                // Check file type
                const validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                    corError.textContent = 'Invalid file type. Please upload JPG, PNG, or JPEG.';
                    corError.classList.remove('d-none');
                    corfile.value = '';
                    corPreviewContainer.classList.add('d-none');
                    return;
                }

                // Show preview
                const reader = new FileReader();
                reader.onload = (e) => {
                    corPreview.src = e.target.result;
                    corPreviewContainer.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                corPreviewContainer.classList.add('d-none');
            }
        });
    }
</script>
            </main>
        </main>

    </div>

    <%- include('partials/footer') %>
