<%- include("partials/header", { title: "Admin Dashboard" }) %>

<div class="admin-layout">

        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <h3 class="sidebar-title">
                <img src="/images/studford-logo.png" alt="Studford Logo" class="logo-img">
                <div class="title-text">StudRec Admin</div>
            </h3>        <ul class="sidebar-menu">
            <li><a href="/admin/dashboard" class="active"><i class="bi bi-speedometer2"></i> Dashboard</a></li>

            <li class="has-submenu">
                <a href="/admin/students-personal"><i class="bi bi-people"></i> Manage Students <i class="bi bi-chevron-down"></i></a>

                <ul class="submenu">
                    <li><a href="/admin/students-personal">Personal Information</a></li>
                    <li><a href="/admin/students-academic">Academic Information</a></li>
                    <li><a href="/admin/students-accounts">Accounts</a></li>
                    <li><a href="/admin/add-student">Add New Student</a></li>
                </ul>
            </li>

            <li><a href="/admin/courses"><i class="bi bi-journal-bookmark"></i> Manage Courses</a></li>
        </ul>

    </aside>

    <!-- Main Content -->
    <main class="admin-content">
        <!-- Top Navigation Header -->
        <header class="admin-header">
            <div class="header-middle">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Search...">
                    <i class="bi bi-search search-icon"></i>
                </div>
            </div>

            <div class="header-right">
                <div class="dropdown">
                    <button class="btn-profile-dropdown" type="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                        <li><a class="dropdown-item" href="/admin/logout"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="admin-main-content">
            <h2 class="fw-bold mb-4">Dashboard Overview</h2>

        <!-- Dashboard Cards -->
        <div class="row g-4 mb-4">

            <div class="col-md-3">
                <div class="stat-card shadow-sm">
                    <div class="icon-wrapper bg-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h3><%= studentCount %></h3>
                        <p>Total Students</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-card shadow-sm">
                    <div class="icon-wrapper bg-success">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <div>
                        <h3><%= courseCount %></h3>
                        <p>Total Courses</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-card shadow-sm">
                    <div class="icon-wrapper bg-info">
                        <i class="bi bi-gender-male"></i>
                    </div>
                    <div>
                        <h3><%= maleCount %></h3>
                        <p>Male Students</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-card shadow-sm">
                    <div class="icon-wrapper bg-warning">
                        <i class="bi bi-gender-female"></i>
                    </div>
                    <div>
                        <h3><%= femaleCount %></h3>
                        <p>Female Students</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Charts and Tables Row -->
        <div class="row g-4">
            <!-- Students per Course -->
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-bar-chart-fill"></i> Students per Course</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Course</th>
                                        <th class="text-end">Students</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% studentsPerCourse.forEach(course => { %>
                                        <tr>
                                            <td><%= course.course_name.trim() %></td>
                                            <td class="text-end">
                                                <span class="badge bg-primary"><%= course.student_count %></span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Students per Academic Year -->
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-calendar3"></i> Students per Academic Year</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Academic Year</th>
                                        <th class="text-end">Students</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% studentsPerYear.forEach(year => { %>
                                        <tr>
                                            <td><%= year.academicyear %></td>
                                            <td class="text-end">
                                                <span class="badge bg-success"><%= year.count %></span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Students -->
        <div class="row g-4 mt-3">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recently Added Students</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Student ID</th>
                                        <th>Name</th>
                                        <th>Course</th>
                                        <th>Date of Birth</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentStudents.forEach(student => { %>
                                        <tr>
                                            <td><%= student.student_id %></td>
                                            <td><%= student.firstname %> <%= student.lastname %></td>
                                            <td><%= student.course_name.trim() %></td>
                                            <td><%= new Date(student.dateofbirth).toLocaleDateString() %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        </div>
    </main>

</div>

<%- include("partials/footer") %>
