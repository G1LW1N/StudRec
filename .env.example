# Database Configuration
# Option 1: Use DATABASE_URL for cloud databases (Render, Railway, etc.)
# Get the EXTERNAL connection string from your Render PostgreSQL dashboard
DATABASE_URL=postgresql://user:password@host.region-postgres.render.com/database_name

# Option 2: Use individual variables for local PostgreSQL
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_DATABASE=studrec
# DB_PORT=5432

# Session Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_random_secret_here

# Environment
NODE_ENV=production
