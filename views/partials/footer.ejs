<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Logout handler with cache clearing
    function handleLogout(event, url) {
        event.preventDefault();
        
        // Clear sessionStorage and localStorage
        sessionStorage.clear();
        localStorage.clear();
        
        // Use fetch to call logout endpoint first, then redirect
        fetch(url, {
            method: 'GET',
            credentials: 'same-origin',
            cache: 'no-store'
        }).then(() => {
            // Force redirect without cache
            window.location.replace(url.replace('/logout', '/login'));
        }).catch(() => {
            // Fallback if fetch fails
            window.location.replace(url.replace('/logout', '/login'));
        });
    }

    // Prevent back button after logout - check if user is on a protected page
    window.addEventListener('pageshow', function(event) {
        // Check if page was loaded from cache (back button)
        if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
            // If on dashboard page, force reload to check session
            if (window.location.pathname.includes('/dashboard')) {
                window.location.reload(true);
            }
        }
    });
    
    // Additional check for protected pages
    window.addEventListener('load', function() {
        if (window.location.pathname.includes('/dashboard')) {
            // Disable caching for this page
            window.history.replaceState(null, null, window.location.href);
        }
    });

    // COR Upload
    document.addEventListener("DOMContentLoaded", function() {
        const corInput = document.getElementById("corfile");
        const corPreviewContainer = document.getElementById("corPreviewContainer");
        const corPreview = document.getElementById("corPreview");
        const corError = document.getElementById("corError");
        const maxSizeMB = 2;

        corInput.addEventListener("change", function() {
            const file = this.files[0];

            if (!file) {
                corPreviewContainer.classList.add("d-none");
                corError.classList.add("d-none");
                return;
            }

            // Validate file type
            const validTypes = ["image/jpeg", "image/jpg", "image/png"];
            if (!validTypes.includes(file.type)) {
                corError.textContent = "Invalid file type. Only JPG, JPEG, or PNG allowed.";
                corError.classList.remove("d-none");
                corPreviewContainer.classList.add("d-none");
                corInput.value = "";
                return;
            }

            // Validate file size
            const fileSizeMB = file.size / (1024 * 1024);
            if (fileSizeMB > maxSizeMB) {
                corError.textContent = `File too large. Max size is ${maxSizeMB}MB.`;
                corError.classList.remove("d-none");
                corPreviewContainer.classList.add("d-none");
                corInput.value = "";
                return;
            }

            // Preview the image
            const reader = new FileReader();
            reader.onload = function(e) {
                corPreview.src = e.target.result;
                corPreviewContainer.classList.remove("d-none");
                corError.classList.add("d-none");
            };
            reader.readAsDataURL(file);
        });
    });
</script>

<script>
    // Course & Section Script
    document.addEventListener("DOMContentLoaded", () => {
        const courseSelect = document.getElementById("courseSelect");
        const sectionSelect = document.getElementById("sectionSelect");

        courseSelect.addEventListener("change", async () => {
            const courseID = courseSelect.value;

            // Clear old sections
            sectionSelect.innerHTML = `<option disabled selected>Loading...</option>`;

            try {
                const response = await fetch(`/student/sections/${courseID}`);
                const sections = await response.json();

                sectionSelect.innerHTML = `<option disabled selected>Select Section</option>`;

                sections.forEach(sec => {
                    const option = document.createElement("option");
                    option.value = sec;
                    option.textContent = `${sec}`;
                    sectionSelect.appendChild(option);
                });
            } catch (err) {
                sectionSelect.innerHTML = `<option disabled selected>Error loading sections</option>`;
            }
        });
    });
</script>




</body>
</html>